# Copy to .env (dev) or .env.production (builds) and adjust.
# Local stack: values from `npx supabase status` (these are the CLI's fixed
# local defaults, not secrets). For the hosted project use its URL and its
# *publishable* key from the dashboard (Project Settings -> API Keys).
# Never put the service role / secret key here: it would ship inside the app.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
