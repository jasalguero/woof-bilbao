{
  "extends": "$app/tsconfig",
  "include": ["src", "*"],
  "exclude": ["src/service-worker", "src-tauri", "build"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  }
}
